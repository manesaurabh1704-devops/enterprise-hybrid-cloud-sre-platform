# EXAMPLE ONLY — do not commit real secret values to git.
# Apply with real values via: kubectl apply -f secret.yaml (kept out of git)
# or better, via Azure Key Vault + CSI Secret Store driver in production.
apiVersion: v1
kind: Secret
metadata:
  name: platform-api-secret
  namespace: platform-api
type: Opaque
stringData:
  DB_PASSWORD: "REPLACE_ME_AT_DEPLOY_TIME"
